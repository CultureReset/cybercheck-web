# The only address this front end knows. Nothing else in src/ names a host.
VITE_API_BASE=https://your-api.example.com

# Optional. When set, the site runs as a single business (its own domain).
# When empty, the site runs as a directory and the slug comes from the URL.
VITE_SINGLE_BUSINESS_SLUG=

# Optional cosmetics for a white-labelled deployment.
VITE_SITE_NAME=
